# Cloud Run用の環境変数設定例
# 実際の値に置き換えて使用してください

# Flask設定
FLASK_APP=src/server
FLASK_ENV=production

# LINE Bot設定
YOUR_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
YOUR_CHANNEL_SECRET=your_line_channel_secret_here

# データベース設定（Firestore with MongoDB compatibility）
# 例 (SCRAM 認証):
# DATABASE_URL=mongodb://<USERNAME>:<PASSWORD>@<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
DATABASE_URL=mongodb://<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&tls=true&retryWrites=false
DATABASE_NAME=your_database_name

# Google Cloud設定
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# サーバー設定
SERVER_URL=https://your-cloud-run-url.run.app
SERVER_ADMIN_LINE_USER_ID=your_admin_line_user_id

# JWT設定
JWT_AUTH_PATH=auth

# フォント設定
FONT_FILE_PATH=/usr/share/fonts/opentype/noto/NotoSerifCJK-Medium.ttc

# Cloud Run固有設定
PORT=8080
