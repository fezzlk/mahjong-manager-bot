# Cloud Run用の環境変数設定例
# 実際の値に置き換えて使用してください
#
# 【重要】以下の変数は Google Secret Manager で管理します
# deploy.sh / cloudbuild.yaml の --set-secrets で自動マウントされるため、
# Cloud Run の --set-env-vars には含めないでください。
#   - DATABASE_URL
#   - YOUR_CHANNEL_ACCESS_TOKEN
#   - YOUR_CHANNEL_SECRET
#   - GOOGLE_CLIENT_ID
#   - GOOGLE_CLIENT_SECRET
#   - GOOGLE_GEMINI_API_KEY
#   - SERVER_ADMIN_LINE_USER_ID
#   - FLASK_SECRET_KEY
#   - JWT_SECRET_KEY
#
# Secret Manager への登録: setup_secrets.sh を参照してください

# -----------------------------------------------------------------------
# 平文 env var（--set-env-vars で設定するもの）
# -----------------------------------------------------------------------

# Flask設定
FLASK_APP=src/server
FLASK_ENV=production

# データベース設定
DATABASE_NAME=your_database_name

# サーバー設定
SERVER_URL=https://your-cloud-run-url.run.app

# JWT設定
JWT_AUTH_PATH=auth

# フォント設定
FONT_FILE_PATH=/usr/share/fonts/opentype/noto/NotoSerifCJK-Medium.ttc

# Cloud Run固有設定
PORT=8080

# -----------------------------------------------------------------------
# Secret Manager 管理（参考: 実際の値は Secret Manager に登録してください）
# -----------------------------------------------------------------------

# DATABASE_URL=mongodb://<USERNAME>:<PASSWORD>@<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
# YOUR_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# YOUR_CHANNEL_SECRET=your_line_channel_secret_here
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# SERVER_ADMIN_LINE_USER_ID=your_admin_line_user_id

# -----------------------------------------------------------------------
# 廃止済み（設定不要）
# -----------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS: Cloud Run は ADC で自動認証されるため不要
