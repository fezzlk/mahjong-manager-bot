# Cloud Run用の環境変数設定例
# 実際の値に置き換えて使用してください

# Flask設定
FLASK_APP=src/server
FLASK_ENV=production

# LINE Bot設定
YOUR_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
YOUR_CHANNEL_SECRET=your_line_channel_secret_here

# データベース設定（Firestore with MongoDB compatibility）
# 例:
# EXTERNAL_DATABASE_URL=mongodb://<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&tls=true&retryWrites=false
# または SCRAM 認証:
# EXTERNAL_DATABASE_URL=mongodb://<USERNAME>:<PASSWORD>@<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
EXTERNAL_DATABASE_URL=mongodb://<UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&tls=true&retryWrites=false
DATABASE_NAME=your_database_name

# PostgreSQL (Cloud SQL) 設定
# いずれかを使用
# 1) DSN
# POSTGRES_DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>
# 2) 分割指定
# POSTGRES_HOST=<HOST_OR_/cloudsql/INSTANCE_CONNECTION_NAME>
# POSTGRES_PORT=5432
# POSTGRES_DB=<DB_NAME>
# POSTGRES_USER=<USER>
# POSTGRES_PASSWORD=<PASSWORD>
# POSTGRES_SSLMODE=require

# Google Cloud設定
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# サーバー設定
SERVER_URL=https://your-cloud-run-url.run.app
SERVER_ADMIN_LINE_USER_ID=your_admin_line_user_id

# JWT設定
JWT_AUTH_PATH=auth

# フォント設定
FONT_FILE_PATH=/usr/share/fonts/opentype/noto/NotoSerifCJK-Medium.ttc

# Cloud Run固有設定
PORT=8080
